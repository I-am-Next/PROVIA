### =========================================================
### AUTHENTICATION
### LOGIN PROVIDER
### =========================================================

POST http://localhost:4007/api/v1/auth/login
Content-Type: application/json

{
  "email": "ProviderTest@example.com",
  "password": "Passwordtest"
}


### =========================================================
### PROFILE PHOTO
### UPLOAD PROFILE PHOTO
### =========================================================

POST {{baseUrl}}/api/v1/media/profile-photo
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary={{multipartBoundary}}

--{{multipartBoundary}}
Content-Disposition: form-data; name="file"; filename="profile-photo.jpg"
Content-Type: image/jpeg

< C:/Users/USER/IdeaProjects/handy-app/media-storage/test-files/profile-photo.jpg
--{{multipartBoundary}}--


### =========================================================
### PROFILE PHOTO
### GET MEDIA METADATA
### =========================================================

GET {{baseUrl}}/api/v1/media/{{profileMediaId}}
Authorization: Bearer {{accessToken}}


### =========================================================
### PROFILE PHOTO
### GET MEDIA CONTENT
### =========================================================

GET {{mediaUrl}}/api/v1/media/{{profileMediaId}}/content
Authorization: Bearer {{accessToken}}


### =========================================================
### DOCUMENT
### UPLOAD DOCUMENT
### =========================================================

POST {{baseUrl}}/api/v1/media/document
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary={{multipartBoundary}}

--{{multipartBoundary}}
Content-Disposition: form-data; name="file"; filename="test-document.pdf"
Content-Type: application/pdf

< C:/Users/USER/IdeaProjects/handy-app/media-storage/test-files/test-document.pdf
--{{multipartBoundary}}--


### =========================================================
### DOCUMENT
### GET MEDIA METADATA
### =========================================================

GET {{baseUrl}}/api/v1/media/{{documentMediaId}}
Authorization: Bearer {{accessToken}}


### =========================================================
### DOCUMENT
### GET MEDIA CONTENT
### =========================================================

GET {{baseUrl}}/api/v1/media/{{documentMediaId}}/content
Authorization: Bearer {{accessToken}}


### =========================================================
### SECURITY
### ATTEMPT TO ACCESS SOMEONE ELSE'S PRIVATE MEDIA
### =========================================================

GET {{baseUrl}}/api/v1/media/{{documentMediaId}}/content
Authorization: Bearer {{secondUserAccessToken}}


### =========================================================
### PUBLIC MEDIA
### SECOND USER ACCESSING PUBLIC PROFILE PHOTO
### =========================================================

GET {{baseUrl}}/api/v1/media/{{profileMediaId}}/content
Authorization: Bearer {{secondUserAccessToken}}


### =========================================================
### DELETE MEDIA
### =========================================================

DELETE {{baseUrl}}/api/v1/media/{{profileMediaId}}
Authorization: Bearer {{accessToken}}