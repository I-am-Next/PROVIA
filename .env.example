# ==========================================
# PROVIA - INTELLIJ LOCAL DEVELOPMENT
# Services run directly on Windows
# ==========================================

# ------------------------------------------
# Shared authentication configuration
# ------------------------------------------
# Generate a strong secret for local development.
JWT_SECRET=your-local-jwt-secret
JWT_ISSUER=provia-auth


# ------------------------------------------
# Auth Service
# ------------------------------------------
AUTH_DB_URL=jdbc:postgresql://localhost:5433/auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=your-auth-database-password


# ------------------------------------------
# Booking Service
# ------------------------------------------
BOOKING_DB_URL=jdbc:postgresql://localhost:5435/booking_db
BOOKING_DB_USERNAME=booking_user
BOOKING_DB_PASSWORD=your-booking-database-password


# ------------------------------------------
# User Service
# ------------------------------------------
USER_DB_URL=jdbc:postgresql://localhost:5436/user_db
USER_DB_USERNAME=user_user
USER_DB_PASSWORD=your-user-database-password


# ------------------------------------------
# Provider Service
# ------------------------------------------
PROVIDER_DB_URL=jdbc:postgresql://localhost:5437/provider_db
PROVIDER_DB_USERNAME=provider_user
PROVIDER_DB_PASSWORD=your-provider-database-password


# ------------------------------------------
# Catalog Service
# ------------------------------------------
CATALOG_DB_URL=jdbc:postgresql://localhost:5438/catalog_db
CATALOG_DB_USERNAME=catalog_user
CATALOG_DB_PASSWORD=your-catalog-database-password
CATALOG_SERVICE_URL=http://localhost:5006


# ------------------------------------------
# Search Service
# ------------------------------------------
SEARCH_DB_URL=jdbc:postgresql://localhost:5434/search_db
SEARCH_DB_USERNAME=search_user
SEARCH_DB_PASSWORD=your-search-database-password
SEARCH_KAFKA_GROUP_ID=search-group
ELASTICSEARCH_URI=http://localhost:9200


# ------------------------------------------
# Payment Service
# ------------------------------------------
PAYMENT_DB_URL=jdbc:postgresql://localhost:5439/payment_db
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=your-payment-database-password

PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_CALLBACK_URL=your-paystack-callback-url


# ------------------------------------------
# Notification Service
# ------------------------------------------
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5440/notification_db
NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=your-notification-database-password


# ------------------------------------------
# Rating Service
# ------------------------------------------
RATING_DB_URL=jdbc:postgresql://localhost:5441/rating_db
RATING_DB_USERNAME=rating_user
RATING_DB_PASSWORD=your-rating-database-password
RATING_SERVICE_URL=http://localhost:4006


# ------------------------------------------
# Media Service
# ------------------------------------------
MEDIA_DB_URL=jdbc:postgresql://localhost:5443/media_db
MEDIA_DB_USERNAME=media_user
MEDIA_DB_PASSWORD=your-media-database-password


# ------------------------------------------
# Shared infrastructure
# ------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379


# ------------------------------------------
# Internal service authentication
# ------------------------------------------
INTERNAL_SERVICE_KEY=your-internal-service-key


# ------------------------------------------
# MinIO - local development
# ------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-root-password


# ------------------------------------------
# AWS
# ------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key